# Disk images and art files are byte-exact test material. Never let a
# checkout on Windows rewrite a newline inside one -- a single CRLF
# conversion silently corrupts a .d64 and every golden test with it.
*.d64 binary
*.prg binary
*.bin binary
art-examples/*.txt -text
tests/**/*.txt -text

# Source is normalised to LF in the repo, checked out native.
*.py text
*.md text
*.yml text
